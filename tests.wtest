import juego.*
import wollok.game.*

describe "todas las jugadas posibles" {
  test "piedra contra piedra" {
    juego.jugadaComputadora(piedra)
    juego.jugar(piedra)
    assert.equals("empate", juego.resultado())
  }
  
  test "piedra contra papel resulta en derrota " {
    juego.jugadaComputadora(papel)
    juego.jugar(piedra)
    assert.equals("perdiste", juego.resultado())
  }
  
  test "piedra contra tijera resulta en victoria " {
    juego.jugadaComputadora(tijera)
    juego.jugar(piedra)
    assert.equals("ganaste", juego.resultado())
  }
  
  test "papel contra piedra resulta en victoria " {
    juego.jugadaComputadora(piedra)
    juego.jugar(papel)
    assert.equals("ganaste", juego.resultado())
  }
  
  test "papel contra papel resulta en empate " {
    juego.jugadaComputadora(papel)
    juego.jugar(papel)
    assert.equals("empate", juego.resultado())
  }
  
  test "papel contra tijera resulta en derrota " {
    juego.jugadaComputadora(tijera)
    juego.jugar(papel)
    assert.equals("perdiste", juego.resultado())
  }
  
  test "tijera contra piedra resulta en derrota " {
    juego.jugadaComputadora(piedra)
    juego.jugar(tijera)
    assert.equals("perdiste", juego.resultado())
  }
  
  test "tijera contra papel resulta en victoria " {
    juego.jugadaComputadora(papel)
    juego.jugar(tijera)
    assert.equals("ganaste", juego.resultado())
  }
  
  test "tijera contra tijera resulta en empate " {
    juego.jugadaComputadora(tijera)
    juego.jugar(tijera)
    assert.equals("empate", juego.resultado())
  }
}

describe "le gana a" {
  test "piedra le gana a tijera " {
    assert.that(piedra.leGanaA(tijera))
  }
  
  test "piedra no le gana a papel " {
    assert.notThat(piedra.leGanaA(papel))
  }
  
  test "papel le gana a piedra " {
    assert.that(papel.leGanaA(piedra))
  }
  
  test "papel no le gana a tijera " {
    assert.notThat(papel.leGanaA(tijera))
  }
  
  test "tijera le gana a papel " {
    assert.that(tijera.leGanaA(papel))
  }
  
  test "tijera no le gana a piedra " {
    assert.notThat(tijera.leGanaA(piedra))
  }
}

describe "mostrar la jugada de la PC" {
  test "aparece en la posición indicada" {
    assert.equals(game.at(14, 8), jugadaPc.position())
  }
  
  test "al principio es dude" {
    assert.equals("dude.png", jugadaPc.image())
  }
  
  test "si se elije una opción la muestra" {
    juego.jugadaComputadora(tijera)
    assert.equals("tijera_preview.png", jugadaPc.image())
  }
  
  test "si reinicio el juego vuelve a dude" {
    juego.jugadaComputadora(tijera)
    juego.reiniciar()
    assert.equals("dude.png", jugadaPc.image())
  }
}

describe "reinicia correctamente " {
  method initialize() {
    // Simulamos una jugada
    juego.jugadaComputadora(tijera)
    juego.jugar(piedra)
    juego.resultado()
  }
  
  test "después de jugar el estado es el esperado" {
    assert.equals(tijera, juego.jugadaComputadora())
    assert.that(juego.mostrarResultado())
    assert.equals("ganaste", juego.resultado())
    assert.notThat(juego.puedeJugar())
  }
  
  test "reiniciar vuelve al estado inicial" {
    juego.reiniciar()
    assert.equals(dude, juego.jugadaComputadora())
    assert.notThat(juego.mostrarResultado())
    assert.equals("", juego.resultado())
    assert.that(juego.puedeJugar())
  }
}

describe "El cartel resultado se muestra correctamente" {
  test "se muestra" {
    juego.mostrarResultado(true)
    assert.equals(game.at(13, 6), cartelResultado.position())
  }
  
  test "no se muestra" {
    juego.mostrarResultado(false)
    assert.equals(game.at(0, 20), cartelResultado.position())
  }
}

describe "El cursor funciona correctamente" {
  test "empieza en papel" {
    assert.equals(papel, juego.opcionSeleccionada())
    assert.equals(papel.position().down(1), cursor.position())
  }
  
  test "a la izquierda selecciona piedra" {
    juego.moverIzquierda()
    assert.equals(piedra, juego.opcionSeleccionada())
    assert.equals(piedra.position().down(1), cursor.position())
  }
  
  test "a la derecha selecciona tijera" {
    juego.moverDerecha()
    assert.equals(tijera, juego.opcionSeleccionada())
    assert.equals(tijera.position().down(1), cursor.position())
  }
}