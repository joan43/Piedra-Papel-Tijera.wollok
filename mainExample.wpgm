import wollok.game.*
import juego.*

program PiedraPapelTijera {
	game.title("Piedra, Papel o Tijera")
	game.height(12)
	game.width(34)
    
	game.addVisual(aclaracion)
	game.addVisual(btnreiniciar)
	game.addVisual(piedra)
	game.addVisual(papel)
	game.addVisual(tijera)
	game.addVisual(humano)
	game.addVisual(computadora)
	game.addVisual(cursor)
	game.addVisual(cartelResultado)
    game.addVisual(jugadaPc)

	// capturamos la flecha izquierda
	keyboard.left().onPressDo {
		juego.moverIzquierda()
	}

	// capturamos la flecha derecha
	keyboard.right().onPressDo {
		juego.moverDerecha()
	}

	// capturamos ENTER para jugar
	keyboard.enter().onPressDo {
       if (juego.puedeSeleccionar()) {
            juego.animando(true)
            juego.contadorAnimacion(0)
        }
    }

    // presionar R para reiniciar
	keyboard.r().onPressDo {
        if (juego.estaTerminado()) {
    		juego.reiniciar()
        }
    }

    const animacion = game.tick(100, {

    if (juego.animando()) {

        juego.jugadaComputadora(
            [piedra, papel, tijera].anyOne()
        )

        juego.contadorAnimacion(
            juego.contadorAnimacion() + 1
        )

        if (juego.contadorAnimacion() >= 35) {

            juego.animando(false)

            juego.jugadaRandomDeComputadora()

            juego.jugar(
                juego.opcionSeleccionada()
            )
        }
        }

    }, false)

    animacion.start()
	game.start()
}