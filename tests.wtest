import game.*
import mainExample.*



 describe "  probar todas las jugadas posibles  "{

  test " piedra contra piedra resulta en empate " {
    juego.jugadaComputadora("piedra")

    assert.equals("empate", juego.jugar("piedra"))
  }

  test " piedra contra papel resulta en derrota " {
    juego.jugadaComputadora("papel")

    assert.equals("perdiste", juego.jugar("piedra"))
  }

  test " piedra contra tijera resulta en victoria " {
    juego.jugadaComputadora("tijera")

    assert.equals("ganaste", juego.jugar("piedra"))
  }

  test " papel contra piedra resulta en victoria " {
    juego.jugadaComputadora("piedra")

    assert.equals("ganaste", juego.jugar("papel"))
  }

  test " papel contra papel resulta en empate " {
    juego.jugadaComputadora("papel")

    assert.equals("empate", juego.jugar("papel"))
  }

  test " papel contra tijera resulta en derrota " {
    juego.jugadaComputadora("tijera")

    assert.equals("perdiste", juego.jugar("papel"))
  }

  test " tijera contra piedra resulta en derrota " {
    juego.jugadaComputadora("piedra")

    assert.equals("perdiste", juego.jugar("tijera"))
  }

  test " tijera contra papel resulta en victoria " {
    juego.jugadaComputadora("papel")

    assert.equals("ganaste", juego.jugar("tijera"))
  }

  test " tijera contra tijera resulta en empate " {
    juego.jugadaComputadora("tijera")

    assert.equals("empate", juego.jugar("tijera"))
  }

 }




 describe " Funciona el metodo que define quien gana en cada objeto" {

  test " piedra le gana a tijera " {
      assert.that(piedra.leGanaA(tijera))
    }

   test " piedra no le gana a papel " {
      assert.notThat(piedra.leGanaA(papel))
   }

  test " papel le gana a piedra " {
       assert.that(papel.leGanaA(piedra))
  }

  test " papel no le gana a tijera " {
       assert.notThat(papel.leGanaA(tijera))
   }

   test " tijera le gana a papel " {
     assert.that(tijera.leGanaA(papel))
    }

  test " tijera no le gana a piedra " {
       assert.notThat(tijera.leGanaA(piedra))
   }

}




